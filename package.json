{
  "name": "myactualnewapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host localhost --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host localhost --port 4173 --strictPort",
    "build:api": "npm --prefix functions run build",
    "test:integration": "firebase emulators:exec --project demo-soundroom --only auth,firestore,storage \"npm --prefix functions test\"",
    "emulators": "firebase emulators:start --project demo-soundroom",
    "check": "npm run typecheck && npm --prefix functions run typecheck",
    "test:audio": "node --experimental-strip-types --test tests/*.test.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "seed:local": "node functions/scripts/seed-local.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "firebase": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.4.0",
    "firebase-tools": "^15.35.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.3",
    "vite": "^8.3.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
